rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function userEmail() {
      return request.auth.token.email;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isWorkspaceMember(workspaceId) {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/workspaces/$(workspaceId)) &&
        userEmail() != null &&
        userEmail() in get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.memberEmails;
    }

    // User profile and private user-scoped data
    match /users/{userId} {
      allow read, write: if isOwner(userId);

      match /{subcollection}/{docId} {
        allow read, write: if isOwner(userId);
      }
    }

    // Workspaces collection and subcollections (members, comments, typing)
    match /workspaces/{workspaceId} {
      allow read: if isAuthenticated() && userEmail() != null && userEmail() in resource.data.memberEmails;
      allow create: if isAuthenticated() && userEmail() != null && userEmail() in request.resource.data.memberEmails;
      allow update: if isAuthenticated() && userEmail() != null && (userEmail() in resource.data.memberEmails || userEmail() in request.resource.data.memberEmails);
      allow delete: if isAuthenticated() && userEmail() != null && userEmail() in resource.data.memberEmails;

      match /members/{memberId} {
        allow read: if isAuthenticated() && (isWorkspaceMember(workspaceId) || (userEmail() != null && resource.data.email == userEmail()));
        allow create: if isAuthenticated() && (isWorkspaceMember(workspaceId) || (userEmail() != null && request.resource.data.email == userEmail()));
        allow update, delete: if isAuthenticated() && isWorkspaceMember(workspaceId);
      }

      match /comments/{commentId} {
        allow read: if isWorkspaceMember(workspaceId);
        allow create: if isWorkspaceMember(workspaceId) && userEmail() != null && request.resource.data.authorEmail == userEmail();
        allow update, delete: if isWorkspaceMember(workspaceId);
      }

      match /typing/{userId} {
        allow read, write: if isWorkspaceMember(workspaceId);
      }
    }

    // Tasks collection: strictly scoped to workspace members and assigned email lists
    match /tasks/{taskId} {
      allow read: if isAuthenticated() && userEmail() != null && (userEmail() in resource.data.memberEmails || (resource.data.workspaceId != null && isWorkspaceMember(resource.data.workspaceId)));
      allow create: if isAuthenticated() && userEmail() != null && (userEmail() in request.resource.data.memberEmails || (request.resource.data.workspaceId != null && isWorkspaceMember(request.resource.data.workspaceId)));
      allow update: if isAuthenticated() && userEmail() != null && ((userEmail() in resource.data.memberEmails || userEmail() in request.resource.data.memberEmails) || (resource.data.workspaceId != null && isWorkspaceMember(resource.data.workspaceId)));
      allow delete: if isAuthenticated() && userEmail() != null && (userEmail() in resource.data.memberEmails || (resource.data.workspaceId != null && isWorkspaceMember(resource.data.workspaceId)));
    }

    // Notes collection: strictly scoped to workspace members and assigned email lists
    match /notes/{noteId} {
      allow read: if isAuthenticated() && userEmail() != null && (userEmail() in resource.data.memberEmails || (resource.data.workspaceId != null && isWorkspaceMember(resource.data.workspaceId)));
      allow create: if isAuthenticated() && userEmail() != null && (userEmail() in request.resource.data.memberEmails || (request.resource.data.workspaceId != null && isWorkspaceMember(request.resource.data.workspaceId)));
      allow update: if isAuthenticated() && userEmail() != null && ((userEmail() in resource.data.memberEmails || userEmail() in request.resource.data.memberEmails) || (resource.data.workspaceId != null && isWorkspaceMember(resource.data.workspaceId)));
      allow delete: if isAuthenticated() && userEmail() != null && (userEmail() in resource.data.memberEmails || (resource.data.workspaceId != null && isWorkspaceMember(resource.data.workspaceId)));
    }

    // Workspace memberships collection
    match /memberships/{membershipId} {
      allow read: if isAuthenticated() && (userEmail() != null && (resource.data.email == userEmail() || (resource.data.workspaceId != null && isWorkspaceMember(resource.data.workspaceId))));
      allow create: if isAuthenticated() && (userEmail() != null && (request.resource.data.email == userEmail() || (request.resource.data.workspaceId != null && isWorkspaceMember(request.resource.data.workspaceId))));
      allow update, delete: if isAuthenticated() && (userEmail() != null && (resource.data.email == userEmail() || (resource.data.workspaceId != null && isWorkspaceMember(resource.data.workspaceId))));
    }

    // Workspace members global collection
    match /workspace_members/{memberId} {
      allow read: if isAuthenticated() && (userEmail() != null && (resource.data.email == userEmail() || (resource.data.workspaceId != null && isWorkspaceMember(resource.data.workspaceId))));
      allow create: if isAuthenticated() && (userEmail() != null && (request.resource.data.email == userEmail() || (request.resource.data.workspaceId != null && isWorkspaceMember(request.resource.data.workspaceId))));
      allow update, delete: if isAuthenticated() && (userEmail() != null && (resource.data.email == userEmail() || (resource.data.workspaceId != null && isWorkspaceMember(resource.data.workspaceId))));
    }

    // Default deny rule
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
