# AI & API Configuration
# GEMINI_API_KEY: Recommended Google Gemini API Key from Google AI Studio.
GEMINI_API_KEY="dummy_gemini_api_key"

# OPENROUTER_API_KEY: Optional development fallback key.
# In production release APKs/AABs, users can provide their own key in Settings (BYOK)
# or requests can route via an App Check protected backend.
OPENROUTER_API_KEY="dummy_openrouter_api_key"
