<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_tasks_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_card"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- Top Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingBottom="8dp">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/kalynt_flow_main_icon"
            android:contentDescription="Kalynt Flow" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:text="KALYNT FLOW"
                android:textColor="#A1A1AA"
                android:textSize="10sp"
                android:letterSpacing="0.1" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Priorities &amp; Notes"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Tasks count badge -->
        <TextView
            android:id="@+id/widget_task_count_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:background="@drawable/widget_badge_bg"
            android:paddingHorizontal="7dp"
            android:paddingVertical="3dp"
            android:text="0 items"
            android:textColor="#E4E4E7"
            android:textSize="10sp"
            android:textStyle="bold" />

        <!-- Quick Add Button in Header -->
        <ImageView
            android:id="@+id/btn_widget_header_add_task"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="@drawable/widget_action_btn_bg"
            android:padding="6dp"
            android:src="@drawable/ic_widget_add"
            android:contentDescription="Add Task" />
    </LinearLayout>

    <!-- Scrollable Items ListView -->
    <ListView
        android:id="@+id/widget_tasks_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="@android:color/transparent"
        android:dividerHeight="4dp"
        android:scrollbars="none" />

    <!-- Empty State View (Shown when ListView has 0 items) -->
    <LinearLayout
        android:id="@+id/widget_tasks_empty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone">

        <ImageView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/ic_widget_check_circle"
            android:contentDescription="All Done" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="All caught up!"
            android:textColor="#F4F4F5"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Tap + to create a task or note"
            android:textColor="#71717A"
            android:textSize="10sp" />
    </LinearLayout>

</LinearLayout>
