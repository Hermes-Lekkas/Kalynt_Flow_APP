<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Strict TLS enforcement: cleartext traffic is completely disallowed across the application -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
